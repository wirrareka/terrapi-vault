# vesta-sync.env — config for the personal sync server (Svet B).
# vesta-sync is single-user/personal: NO residency, NO tenants, NO platform creds.
# Device auth is app-layer (ed25519 request signatures); confidentiality in transit is
# provided by TLS terminated in front of this process (see docs/sync-bootstrap.md).

# Bind address. Keep it on loopback (or a WireGuard/Tailscale /32) and let a TLS reverse
# proxy face the internet. Do NOT expose this plaintext port directly.
VESTA_SYNC_BIND=127.0.0.1:8300

# SQLite database. Holds ONLY opaque encrypted ops + device pubkeys + the enrolment verifier
# (never the vault key or plaintext). Back this file up; losing it loses unsynced ops.
VESTA_SYNC_DB=/var/lib/vesta-sync/vesta-sync.db

# At-rest encryption (SQLCipher). RECOMMENDED. Op CONTENT is already E2E-encrypted, but the
# DB metadata (op/device counts, timing, op sizes, cleartext collection_id, device pubkeys)
# is NOT — at-rest encryption protects it if the disk/backup is stolen. Set ONE of:
#   VESTA_SYNC_DB_KEY=<passphrase>                      # simplest (but lands in the process env)
#   VESTA_SYNC_DB_KEY_FILE=/var/lib/vesta-sync/db.key   # PREFERRED: a mode-600 file, not in env
# Set it BEFORE first run (it can't transparently encrypt an existing plaintext DB — migrate
# with sqlcipher_export if you already have one). Back the key up SEPARATELY from the DB.
# VESTA_SYNC_DB_KEY_FILE=/var/lib/vesta-sync/db.key

# Prometheus metrics on a SEPARATE listener (default 127.0.0.1:8301). NEVER put this behind the
# public TLS proxy — op/device counts are the same metadata at-rest protects. Loopback and
# private/WG (RFC1918, e.g. 10.x / 192.168.x) binds are allowed; a 0.0.0.0 / routable-public bind
# is refused (the listener is disabled) unless you set VESTA_SYNC_METRICS_ALLOW_PUBLIC=1.
# VESTA_SYNC_METRICS_BIND=127.0.0.1:8301
# VESTA_SYNC_METRICS_ALLOW_PUBLIC=1   # only if you genuinely front /metrics on a public address

# Optional limits (safe defaults shown).
# VESTA_SYNC_MAX_BODY_BYTES=16777216   # 16 MiB push-batch cap
# VESTA_SYNC_MAX_PULL=500              # max ops returned per pull page
# VESTA_SYNC_READERS=4                 # read-only WAL connections beside the writer
