# vesta-console.env — env drop-in for the rc.d service.
# Install to /usr/local/etc/vesta-console/vesta-console.env  (mode 0600, root:vesta-console).
# The rc.d wrapper sources this with `set -a` so VESTA_CONSOLE_* are exported. NEVER commit real
# secrets (the OIDC client secret / cert key are placed on-wire at deploy).

# --- Listener (WG /32; browser↔console security = WG + the optional Kalista edge) ------------
# eu console WG IP is 10.200.0.110 (infra-confirmed). Bind the /32, never 0.0.0.0.
VESTA_CONSOLE_BIND=10.200.0.110:8203
# Per-instance residency group; eu and uae NEVER co-reside (one console per group).
VESTA_CONSOLE_RESIDENCY_GROUP=eu

# --- Brokers to aggregate (this group only) --------------------------------------------------
# Comma-separated id@host:port. The console fans out to each broker's read-only observe API.
VESTA_CONSOLE_BROKERS=vault-eu-1@10.200.0.101:8200

# --- mTLS to the brokers (the console's fleet-CA client cert) --------------------------------
# Cert `vesta-console.<group>.proximi.internal` (dual-EKU: clientAuth for this hop + serverAuth
# for the optional edge), +IP SAN .110, minted by infra at deploy (0600). The fleet Root CA is
# the SOLE trust root for the brokers' server certs.
VESTA_CONSOLE_TLS_CERT=/usr/local/etc/vesta-console/tls/console.pem
VESTA_CONSOLE_TLS_KEY=/usr/local/etc/vesta-console/tls/console.key
VESTA_CONSOLE_TLS_CLIENT_CA=/usr/local/etc/vesta-console/tls/fleet-root-ca.pem

# --- OIDC RP (P1b — login via identity) ------------------------------------------------------
# Login via terrapi-identity: authorization_code + PKCE, acr=mfa ENFORCED, private_key_jwt client
# auth signed RS256 with the cert KEY ABOVE (VESTA_CONSOLE_TLS_KEY) — NO shared secret. identity
# binds the public JWK of that cert (kid = its RFC 7638 thumbprint) to the `vesta-console` client.
# Set ISSUER/REDIRECT_URI/KID to enable login; unset ISSUER ⇒ login disabled (dev or all-401).
VESTA_CONSOLE_OIDC_ISSUER=https://identity.eu.proximi.fi/
VESTA_CONSOLE_OIDC_REDIRECT_URI=https://vesta-console.eu.proximi.fi/api/v1/auth/callback
# kid = the RFC 7638 thumbprint of the console cert's public key (the eu cert minted 2026-06-08).
VESTA_CONSOLE_OIDC_KID=Kqlz8rNa3Cwz5pUtS1JamQj5f4vd7AmaMeXC1LOyJ88
# Optional (defaults shown): client id, scopes, required acr.
# VESTA_CONSOLE_OIDC_CLIENT_ID=vesta-console
# VESTA_CONSOLE_OIDC_SCOPES="openid profile email"
# VESTA_CONSOLE_OIDC_ACR=mfa

# --- Local dev only (NEVER in prod) ----------------------------------------------------------
# Grants a `dev` operator session (no OIDC) + accepts self-signed broker certs.
# VESTA_CONSOLE_ALLOW_INSECURE_DEV=1
