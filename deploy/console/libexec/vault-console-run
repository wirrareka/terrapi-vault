#!/bin/sh
# vault-console-run — rc.d exec wrapper. daemon(8) runs this as the `vault-console` user.
#
# Sources the env drop-in with `set -a` so every VAULT_CONSOLE_* is EXPORTED, then execs the
# console. Separate script so rc.d `command_args` needs no embedded quotes (rc.subr word-splits
# and does NOT honor inline quotes). The env-file path comes from $VC_ENV (set by rc.d via env(1)).
set -eu

: "${VC_ENV:?VC_ENV not set (rc.d must pass it)}"
set -a
. "${VC_ENV}"
set +a
exec /usr/local/sbin/vault-console
