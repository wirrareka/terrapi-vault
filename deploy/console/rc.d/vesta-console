#!/bin/sh
#
# PROVIDE: vault_console
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# vesta-console — operator web/API console for terrapi-vesta (Rust/Axum). Read-only
# observability that aggregates the group's brokers' `observe` API over mTLS-over-WG and
# serves it (single binary, SPA embedded). ONE instance per residency group, in its own
# bastille vnet jail on the per-group WireGuard mesh. NEVER surfaces a secret value.
#
# No encrypted-dataset / unseal gate (unlike the broker): the console is stateless — sessions
# live in memory; its only at-rest secret is the fleet-CA client cert key (+ the OIDC client
# secret, P1b), held mode-0600 under /usr/local/etc/vesta-console/.
#
# Enable (inside the jail's /etc/rc.conf):
#   vault_console_enable="YES"
#
# Optional overrides (defaults shown):
#   vault_console_runas="vesta-console"
#   vault_console_envfile="/usr/local/etc/vesta-console/vesta-console.env"   # mode 0600
#   vault_console_log="/var/log/vesta-console.log"

. /etc/rc.subr

name="vault_console"
rcvar="vault_console_enable"
load_rc_config $name

: ${vault_console_enable:="NO"}
# Same rc.subr-magic-name avoidance as the broker: NOT `${name}_{user,group,env,...}` (rc.subr
# hijacks those — double su-drop / `env <path>` exec). Use runas/rungroup/envfile.
: ${vault_console_runas:="vesta-console"}
: ${vault_console_rungroup:="vesta-console"}
: ${vault_console_envfile:="/usr/local/etc/vesta-console/vesta-console.env"}
: ${vault_console_log:="/var/log/vesta-console.log"}
: ${vault_console_runner:="/usr/local/libexec/vesta-console-run"}

pidfile="/var/run/vesta-console.pid"
procname="/usr/local/sbin/vesta-console"

command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -u ${vault_console_runas} -o ${vault_console_log} \
    /usr/bin/env VC_ENV=${vault_console_envfile} ${vault_console_runner}"
start_precmd="vault_console_prestart"
stop_postcmd="vault_console_poststop"

vault_console_prestart() {
    # Env drop-in (broker list + the fleet-CA client cert + OIDC config). Must be mode-600.
    if [ ! -f "${vault_console_envfile}" ]; then
        warn "vesta-console: missing env drop-in ${vault_console_envfile}"
        return 1
    fi
    # The exec wrapper sources the env + execs the console.
    if [ ! -x "${vault_console_runner}" ]; then
        warn "vesta-console: missing exec wrapper ${vault_console_runner}"
        return 1
    fi
    # Touch the log so daemon(8) doesn't create it as root.
    if [ ! -f ${vault_console_log} ]; then
        install -o ${vault_console_runas} -g ${vault_console_rungroup} -m 640 /dev/null ${vault_console_log}
    fi
}

vault_console_poststop() {
    rm -f ${pidfile}
}

run_rc_command "$1"
