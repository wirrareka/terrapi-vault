# vault-console.env — env drop-in for the rc.d service.
# Install to /usr/local/etc/vault-console/vault-console.env  (mode 0600, root:vault-console).
# The rc.d wrapper sources this with `set -a` so VAULT_CONSOLE_* are exported. NEVER commit real
# secrets (the OIDC client secret / cert key are placed on-wire at deploy).

# --- Listener (WG /32; browser↔console security = WG + the optional Kalista edge) ------------
# eu console WG IP is 10.200.0.110 (infra-confirmed). Bind the /32, never 0.0.0.0.
VAULT_CONSOLE_BIND=10.200.0.110:8203
# Per-instance residency group; eu and uae NEVER co-reside (one console per group).
VAULT_CONSOLE_RESIDENCY_GROUP=eu

# --- Brokers to aggregate (this group only) --------------------------------------------------
# Comma-separated id@host:port. The console fans out to each broker's read-only observe API.
VAULT_CONSOLE_BROKERS=vault-eu-1@10.200.0.101:8200

# --- mTLS to the brokers (the console's fleet-CA client cert) --------------------------------
# Cert `vault-console.<group>.proximi.internal` (dual-EKU: clientAuth for this hop + serverAuth
# for the optional edge), +IP SAN .110, minted by infra at deploy (0600). The fleet Root CA is
# the SOLE trust root for the brokers' server certs.
VAULT_CONSOLE_TLS_CERT=/usr/local/etc/vault-console/tls/console.pem
VAULT_CONSOLE_TLS_KEY=/usr/local/etc/vault-console/tls/console.key
VAULT_CONSOLE_TLS_CLIENT_CA=/usr/local/etc/vault-console/tls/fleet-root-ca.pem

# --- OIDC RP (P1b — login via identity) ------------------------------------------------------
# PLACEHOLDERS. identity mints the client once vault pings the final redirect URI + group
# (acr=mfa enforced; private_key_jwt keyed by the cert key above, or client_secret_basic).
# Until set, auth is disabled and only VAULT_CONSOLE_ALLOW_INSECURE_DEV grants a session.
# VAULT_CONSOLE_OIDC_ISSUER=https://identity.eu.proximi.fi/
# VAULT_CONSOLE_OIDC_CLIENT_ID=vault-console
# VAULT_CONSOLE_OIDC_REDIRECT_URI=https://vault-console.eu.proximi.fi/api/v1/auth/callback
# VAULT_CONSOLE_OIDC_CLIENT_SECRET=$(cat /usr/local/etc/vault-console/secrets/oidc.secret)

# --- Local dev only (NEVER in prod) ----------------------------------------------------------
# Grants a `dev` operator session (no OIDC) + accepts self-signed broker certs.
# VAULT_CONSOLE_ALLOW_INSECURE_DEV=1
