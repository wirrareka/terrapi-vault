# vault-sync.env — config for the personal sync server (Svet B).
# vault-sync is single-user/personal: NO residency, NO tenants, NO platform creds.
# Device auth is app-layer (ed25519 request signatures); confidentiality in transit is
# provided by TLS terminated in front of this process (see docs/sync-bootstrap.md).

# Bind address. Keep it on loopback (or a WireGuard/Tailscale /32) and let a TLS reverse
# proxy face the internet. Do NOT expose this plaintext port directly.
VAULT_SYNC_BIND=127.0.0.1:8300

# SQLite database. Holds ONLY opaque encrypted ops + device pubkeys + the enrolment verifier
# (never the vault key or plaintext). Back this file up; losing it loses unsynced ops.
VAULT_SYNC_DB=/var/lib/vault-sync/vault-sync.db

# Optional limits (safe defaults shown).
# VAULT_SYNC_MAX_BODY_BYTES=16777216   # 16 MiB push-batch cap
# VAULT_SYNC_MAX_PULL=500              # max ops returned per pull page
