# Bastillefile — provision a terrapi-vesta broker jail (one per residency group).
#
# Usage (on the bastille host):
#   bastille create vault-eu 14.2-RELEASE 10.200.0.0/24   # eu  WG subnet
#   bastille create vault-uae 14.2-RELEASE 10.210.0.0/24  # uae WG subnet
#   bastille template vault-eu /path/to/terrapi-vesta/deploy/jail --arg GROUP=eu
#
# ASSUMPTIONS (confirm with operator):
#   - FreeBSD 14.2-RELEASE base.
#   - vnet jail (own routing onto the WG mesh).
#   - WG subnets: 10.200.0.0/24 (eu), 10.210.0.0/24 (uae) per residency.md.
#   - The encrypted dataset zroot/terrapi/vault is delegated/mounted into the
#     jail at /var/db/terrapi-vesta (zfs jail delegation OR nullfs of the mount).
#   - The binary is built per deploy/build.sh and present at
#     deploy/jail/usr/local/sbin/vesta-broker before templating.
#
# eu and uae NEVER co-reside: distinct jails, distinct WG meshes, distinct
# datasets, one broker per residency group. No cross-group anything.

# Runtime deps: base + CA trust store only (SQLCipher is bundled; rustls = aws-lc-rs).
PKG ca_root_nss

# Service user (unprivileged; nologin; home on the encrypted dataset).
CMD pw groupadd -n vault 2>/dev/null || true
CMD pw useradd -n vault -g vault -d /var/db/terrapi-vesta -s /usr/sbin/nologin -c "terrapi-vesta broker" 2>/dev/null || true

# Layout.
CMD install -d -m 755 /usr/local/sbin
CMD install -d -m 755 /usr/local/libexec
CMD install -d -m 755 /usr/local/etc/rc.d
CMD install -d -m 755 /usr/local/etc/terrapi-vesta
CMD install -d -m 755 /usr/local/etc/terrapi-vesta/tls
CMD install -d -m 755 /usr/local/etc/terrapi-vesta-deploy

# Binary (built per deploy/build.sh; copy in via bastille cp before templating).
CP usr/local/sbin/vesta-broker /usr/local/sbin/vesta-broker
CMD chmod 755 /usr/local/sbin/vesta-broker

# rc.d scripts. zfskeys MUST come up before vault_broker (rc REQUIRE handles it).
CP rc.d/vesta-broker /usr/local/etc/rc.d/vesta-broker
CP zfs/zfskeys       /usr/local/etc/rc.d/zfskeys
CMD chmod 755 /usr/local/etc/rc.d/vesta-broker /usr/local/etc/rc.d/zfskeys

# rc.d exec wrapper (sources the env drop-in with `set -a`, execs the broker).
CP libexec/vesta-broker-run /usr/local/libexec/vesta-broker-run
CMD chmod 755 /usr/local/libexec/vesta-broker-run

# Contract-check + security helpers (run on demand / from monitoring).
CP zfs/check-encryption.sh /usr/local/etc/terrapi-vesta-deploy/check-encryption.sh
CP security/fim-watchlist.txt /usr/local/etc/terrapi-vesta-deploy/fim-watchlist.txt
CP security/pf.conf.snippet /usr/local/etc/terrapi-vesta-deploy/pf.conf.snippet
CMD chmod 755 /usr/local/etc/terrapi-vesta-deploy/check-encryption.sh

# Config + env drop-in are laid down out-of-band by deploy/install.sh (they carry
# per-instance values + reference dataset secrets). Pre-create with safe perms.
# 0640 root:vault — the broker reads them as the vault user (0600 would deny the read).
CMD touch /usr/local/etc/terrapi-vesta/vesta-broker.env && chown root:vault /usr/local/etc/terrapi-vesta/vesta-broker.env && chmod 640 /usr/local/etc/terrapi-vesta/vesta-broker.env
CMD touch /usr/local/etc/terrapi-vesta/roles.json && chown root:vault /usr/local/etc/terrapi-vesta/roles.json && chmod 640 /usr/local/etc/terrapi-vesta/roles.json

# Enable services.
SYSRC zfskeys_enable=YES
SYSRC vault_broker_enable=YES

# Firewall: deploy/security/pf.conf.snippet — WG-only ingress to :8200 (broker
# API, mTLS-over-WG) and :8201 (metrics, on-box Prometheus). NEVER ext_if.
